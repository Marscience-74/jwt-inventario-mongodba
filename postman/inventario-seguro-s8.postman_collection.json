            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"docente@demo.test\",\n  \"clave\": \"Clase2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
