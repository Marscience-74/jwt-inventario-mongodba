          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "const producto = pm.response.json();",
              "pm.test('El nombre queda sin espacios', () => pm.expect(producto.nombre).to.eql('Regla'));",
